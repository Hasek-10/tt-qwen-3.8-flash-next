# QuietBox 2 (2x p300c = 4 Blackhole dies in one ring: the two on-card links and
# the two Warp400 links).  One 1x4 LINE mesh over three of the four ring links,
# the logical shape the model's Linear collectives assume.  Channel count 2 as
# in the upstream p300_x2 descriptor: the 4-channel p150 QuietBox descriptor
# asserts "Expected 4 eth links" here.  Exported by run_qwen38_chat_server.sh
# --profile qb2 and the tt-model profile c32k-quietbox2; tested on qb2
# 2026-09-18 (standalone) and 2026-09-21 (vllm-tt-plugin, devices [1, 0, 3, 2]).
mesh_descriptors {
  name: "M0"
  arch: BLACKHOLE
  device_topology { dims: [ 1, 4 ] dim_types: [ LINE, LINE ] }
  host_topology   { dims: [ 1, 1 ] }
  channels { count: 2 policy: RELAXED }
}

top_level_instance { mesh { mesh_descriptor: "M0" mesh_id: 0 } }
